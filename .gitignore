# Training-only venv + logs (regenerable; never shipped to production)
.venv-train/
.venv-backend/
training/train_run.log
training/
testing/

# Private/client data and non-backend project material
Data/
guides/
scripts/
.claude/
LABELING_RULES.md
MLMODEL.md
blueprint.md

# OS
.DS_Store

# Regenerable PDF render/inspection intermediates
tmp/pdfs/

# Temporary local inference loader secrets and generated run reports
Temp_Inference/.env*
temp_inference/.env*
Temp_Inference/*.jsonl
temp_inference/*.jsonl
